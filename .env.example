# ===========================================================
#  .env.example - Plantilla de configuración (SIN valores reales)
#  1. Copiar este archivo como .env  ->  cp .env.example .env
#  2. Completar los valores en .env (ese archivo NO se sube a GitHub)
# ===========================================================

# --- Conexión al servidor SQL Server ---
DB_SERVER=
DB_DATABASE=TurismoPeru_ADJG
DB_USER=
DB_PASSWORD=

# --- Contraseñas de los logins a crear (01_usuarios_roles/01_logins.sql) ---
# Deben ser seguras: mínimo 12 caracteres, mayúsculas, minúsculas, números y símbolos.
PWD_ADMIN=
PWD_VENDEDOR=
PWD_ANALISTA=
